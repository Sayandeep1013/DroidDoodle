<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET exists for exactly one reason: the first-run model download of
      docs/25-inference.md §6. ModelStore is the only class in the app that
      opens a socket, and nothing downstream of a completed download touches
      the network. Intent criterion T3 is now an auditable property of that one
      file rather than of the manifest.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="DroidDoodle"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidDoodle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DroidDoodle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
