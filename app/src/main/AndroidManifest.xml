<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission.

      The model download of docs/25-inference.md §6 lands in P8 and will add it
      deliberately. Until then its absence is a hard guarantee that intent
      criterion T3 holds: the app cannot perform network I/O even by accident.
    -->

    <application
        android:allowBackup="true"
        android:label="DroidDoodle"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidDoodle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DroidDoodle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
