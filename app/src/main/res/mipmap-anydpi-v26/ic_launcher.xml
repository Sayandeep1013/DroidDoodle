<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the v26 adaptive form exists. minSdk is 26, so every device this app
  installs on supports it, and shipping legacy PNG densities as well would mean
  binary assets that no supported device would ever load.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
